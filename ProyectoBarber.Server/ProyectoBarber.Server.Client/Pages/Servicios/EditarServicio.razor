@page "/servicios/editar/{Id:int}"
@inject IHttpService http
@inject NavigationManager nav

@* ==================================================================
   CU09 - Gestionar servicios: MODIFICAR (paso 7)
   Trae el servicio con GET api/servicio/{id} y graba con PUT api/servicio/{id}.
   Paso 8: boton Borrar (DELETE api/servicio/{id}) con cartel de confirmacion.
   ================================================================== *@

<PageTitle>Editar servicio</PageTitle>

<SoloDueno>   @* Paso 10 - solo el dueno *@

<h3>Editar servicio</h3>

@if (servicio == null)
{
    <p>@(string.IsNullOrEmpty(mensaje) ? "Buscando ...." : "")</p>
}
else
{
    <EditForm Model="servicio" OnValidSubmit="Grabar" FormName="EditarServicioForm">
        <DataAnnotationsValidator />
        <div class="mb-3" style="max-width: 400px;">
            <label class="form-label">Nombre:</label>
            <InputText class="form-control" @bind-Value="servicio.Nombre" />
            <ValidationMessage For="@(() => servicio.Nombre)" />
        </div>
        <div class="mb-3" style="max-width: 400px;">
            <label class="form-label">Duración estimada (minutos):</label>
            <InputNumber class="form-control" @bind-Value="servicio.Duracion" />
            <ValidationMessage For="@(() => servicio.Duracion)" />
        </div>
        <div class="mb-3" style="max-width: 400px;">
            <label class="form-label">Precio ($):</label>
            <InputNumber class="form-control" @bind-Value="servicio.Precio" />
            <ValidationMessage For="@(() => servicio.Precio)" />
        </div>
        <button class="btn btn-primary" type="submit">Grabar</button>
        <button class="btn btn-secondary" type="button" @onclick="Cancelar">Cancelar</button>
        <button class="btn btn-outline-danger float-end" type="button" @onclick="() => confirmacion!.Ver()">Borrar</button>
    </EditForm>

    @* Paso 8 - Borrar (dentro de Editar), con el cartel de confirmacion *@
    <Confirmacion @ref="confirmacion" Titulo="Borrar servicio" textOk="Borrar"
                  onConfirm="Borrar" onCancel="() => confirmacion!.Ocultar()">
        ¿Seguro que querés borrar el servicio <strong>@servicio.Nombre</strong>?
        <div class="text-muted small mt-2">No se puede si tiene turnos registrados.</div>
    </Confirmacion>
}

<p class="text-danger mt-3">@mensaje</p>
</SoloDueno>

@code {
    [Parameter] public int Id { get; set; }

    private ServicioDTO? servicio;
    private string mensaje = "";

    protected override async Task OnInitializedAsync()
    {
        var resp = await http.GetAsync<ServicioDTO>($"api/servicio/{Id}");
        if (resp.Error)
            mensaje = resp.Mensaje ?? "No se pudo leer el servicio.";
        else
            servicio = resp.Respuesta;
    }

    private async Task Grabar()
    {
        var resp = await http.PutAsync<ServicioDTO, bool>($"api/servicio/{Id}", servicio!);
        if (!resp.Error)
            nav.NavigateTo("/servicios");
        else
            mensaje = resp.Mensaje ?? "No se pudo grabar.";
    }

    private Confirmacion? confirmacion;

    // Paso 8 - DELETE api/servicio/{id}. Si el servidor no lo permite, muestra su mensaje.
    private async Task Borrar()
    {
        confirmacion?.Ocultar();
        var resp = await http.DeleteAsync<bool>($"api/servicio/{Id}");
        if (!resp.Error)
            nav.NavigateTo("/servicios");
        else
            mensaje = resp.Mensaje ?? "No se pudo borrar.";
    }

    private void Cancelar() => nav.NavigateTo("/servicios");
}
