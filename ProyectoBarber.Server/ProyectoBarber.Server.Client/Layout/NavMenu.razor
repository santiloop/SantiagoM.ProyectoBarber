@* Paso 5 - Menu lateral. Se agrega un enlace por cada page nueva.
   Paso 10 - Muestra solo las secciones del rol del usuario:
     Dueno: todo.  Recepcionista: sin Reporte ni Usuarios (servicios, barberos
     y horarios los ve pero no los modifica). *@
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="agenda">ProyectoBarber</a>
    </div>
</div>

<input type="checkbox" title="Menú" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @* CU03 - Consultar agenda (paso 6) *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="agenda">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Agenda
            </NavLink>
        </div>

        @* Paso 12 - Avisos (dueno y recepcionista) *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="avisos">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Avisos
            </NavLink>
        </div>

        @* CU07 - Gestionar clientes (paso 6) *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="clientes">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Clientes
            </NavLink>
        </div>

        @* CU08 - Gestionar barberos (paso 6) *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="barberos">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Barberos
            </NavLink>
        </div>

        @* CU09 - Gestionar servicios *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="servicios">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Servicios
            </NavLink>
        </div>

        @* CU15 / CU08 - Horarios del local y de los barberos (paso 7) *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="horarios">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Horarios
            </NavLink>
        </div>

        @* CU16 - Dias no laborables (paso 7) *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="dianolaborables">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Días no laborables
            </NavLink>
        </div>

        @if (sesion.EsDueno)
        {
            @* CU10 - Reporte (paso 9) - solo dueno *@
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="reporte">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Reporte
                </NavLink>
            </div>

            @* CU11 - Gestionar usuarios (paso 10) - solo dueno *@
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="usuarios">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Usuarios
                </NavLink>
            </div>
        }
    </nav>
</div>
