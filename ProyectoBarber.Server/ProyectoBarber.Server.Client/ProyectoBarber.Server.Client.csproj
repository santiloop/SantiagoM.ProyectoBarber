<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Paso 5 - Cliente Blazor WebAssembly alojado en ProyectoBarber.Server, igual que
       Proyecto2026WA.Cliente de la catedra: tiene su propio wwwroot/index.html y App.razor. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ProyectoBarber.Servicio\ProyectoBarber.Servicio.csproj" />
    <ProjectReference Include="..\..\ProyectoBarber.Shared\ProyectoBarber.Shared.csproj" />
  </ItemGroup>

</Project>
